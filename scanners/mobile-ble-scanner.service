[Unit]
Description=Mobile BLE scanner (recording)
After=network.target bluetooth.service hciuart.service

[Service]
Type=simple
User=root
WorkingDirectory=/home/matheau/air_scan
Environment=PYTHONUNBUFFERED=1

# Master kill switch — blocks start while the air_scan disable flag is set
ExecCondition=/home/matheau/air_scan/scanners/air_scan_ctl.sh check

ExecStartPre=/usr/sbin/rfkill unblock bluetooth
ExecStart=/usr/bin/python3 /home/matheau/air_scan/scanners/mobile_ble_scanner.py

Restart=on-failure
RestartSec=10

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
